<Project Sdk="Microsoft.NET.Sdk">

  <!-- Stage 8C dev helper, deliberately NOT added to NNA.Wallpaper.sln: shows the real TopBarWindow
       (composition-hosted, see TopBar/CompositionInput.cs) on a monitor that does not overlap the
       owner's live top bar (owner: primary-only, i.e. \\.\DISPLAY2 3440x1440; this helper always uses
       the vertical \\.\DISPLAY1 1440x2560), pages served read-only from the owner's already-running
       instance on :1618 (same pattern as tests/WindowPreview — only GETs /topbar/, /topbar/popup/,
       /config, never posts/saves anything), then drives two click+popup checks with real SendInput and
       reports PASS/FAIL lines plus a screenshot. See tests/TopBarPreview/Program.cs and
       tests/topbar-live-probe.ps1 (the wrapper that runs this and parses its output). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>NNA.Wallpaper.TopBarPreview</RootNamespace>
    <AssemblyName>TopBarPreview</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NNA.Wallpaper\NNA.Wallpaper.csproj" />
  </ItemGroup>

</Project>
