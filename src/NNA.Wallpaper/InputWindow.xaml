<Window x:Class="NNA.Wallpaper.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual">
    <Border Background="#0B0B0B" BorderBrush="#434343" BorderThickness="1" CornerRadius="16">
        <StackPanel Width="340" Margin="18,14,18,14">
            <TextBox x:Name="Input" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF"
                     CaretBrush="#FFFFFF" FontFamily="Consolas" FontSize="16" AcceptsReturn="False" />
            <TextBlock Text="Enter — отправить, Esc — отмена" Foreground="#808080" FontSize="10" Margin="0,10,0,0" />
        </StackPanel>
    </Border>
</Window>
