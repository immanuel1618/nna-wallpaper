{
  "id": "weather",
  "name": "Weather + clocks",
  "title": { "ru": "Погода и часы", "en": "Weather + clocks" },
  "version": "1.0.0",
  "author": "NNA1618",
  "entry": { "kind": "module", "path": "widget.js", "export": "weather" },
  "defaultSize": { "cols": 1, "rows": 8 },
  "minSize": { "cols": 1, "rows": 2 },
  "needs": ["weather"],
  "description": { "ru": "Погода и часы нескольких городов.", "en": "Weather and clocks for several cities." },
  "icon": "weather",
  "groups": [
    { "id": "refresh", "label": { "ru": "Обновление", "en": "Refresh" }, "keys": ["refreshMin"] },
    { "id": "clocksGroup", "label": { "ru": "Часы", "en": "Clocks" }, "keys": ["clocks"] }
  ],
  "settings": [
    { "key": "refreshMin", "type": "number", "default": 10, "min": 1, "max": 120,
      "label": { "ru": "Обновление, мин", "en": "Refresh, min" },
      "help": { "ru": "Как часто запрашивать погоду заново.", "en": "How often to refetch the weather." } },
    { "key": "clocks", "type": "list", "item": { "label": "string", "tz": "timezone" },
      "label": { "ru": "Часы", "en": "Clocks" },
      "help": { "ru": "Список городов и часовых поясов для дополнительных часов.", "en": "Cities and time zones shown as extra clocks." },
      "default": [
        { "label": "MOSCOW", "tz": "Europe/Moscow" },
        { "label": "LOS ANGELES", "tz": "America/Los_Angeles" },
        { "label": "VLADIVOSTOK", "tz": "Asia/Vladivostok" }
      ] }
  ]
}
