{
  "id": "eq",
  "name": "Audio equalizer",
  "version": "1.0.0",
  "author": "NNA1618",
  "entry": { "kind": "module", "path": "widget.js", "export": "eq" },
  "defaultSize": { "cols": 1, "rows": 4 },
  "minSize": { "cols": 1, "rows": 2 },
  "needs": ["audio"],
  "settings": [
    { "key": "bars", "type": "number", "label": "Полосы", "default": 56, "min": 8, "max": 128 },
    { "key": "attack", "type": "number", "label": "Атака", "default": 0.55, "min": 0, "max": 1 },
    { "key": "release", "type": "number", "label": "Спад", "default": 0.075, "min": 0, "max": 1 },
    { "key": "gain", "type": "number", "label": "Усиление", "default": 1.7, "min": 0.1, "max": 5 },
    { "key": "minHeight", "type": "number", "label": "Минимальная высота", "default": 0.02, "min": 0, "max": 1 }
  ]
}
