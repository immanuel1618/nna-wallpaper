{
  "id": "night",
  "name": { "ru": "Ночная", "en": "Night" },
  "taskbar": {
    "enabled": true,
    "preset": "night",
    "normal": { "mode": "opaque", "color": "#000000", "opacity": 1 },
    "maximized": { "mode": "opaque", "color": "#000000", "opacity": 1 },
    "fullscreen": { "mode": "opaque", "color": "#000000", "opacity": 1 },
    "windows": {
