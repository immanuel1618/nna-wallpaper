    "reserveSpace": true,
    "modules": [
      { "id": "brand", "side": "left" },
      { "id": "date", "side": "left" },
      { "id": "clock", "side": "center" },
      { "id": "planner", "side": "right" },
      { "id": "media", "side": "right" },
