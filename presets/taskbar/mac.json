{
  "id": "mac",
  "name": { "ru": "Как на Mac", "en": "Mac-like" },
  "taskbar": {
    "enabled": true,
    "preset": "mac",
    "normal": { "mode": "acrylic", "color": "#0B0B0B", "opacity": 0.45 },
    "maximized": { "mode": "opaque", "color": "#0B0B0B", "opacity": 1 },
    "fullscreen": { "mode": "normal", "color": "#0B0B0B", "opacity": 0.5 },
    "windows": {
      "centered": true,
      "hideSearch": true,
      "hideTaskView": true,
      "hideWidgets": true,
      "hideClock": true,
      "small": null,
      "transparency": null,
      "oledTransparency": null,
      "autoHide": false
    },
    "secondary": true
  },
  "topBar": {
    "enabled": true,
    "monitors": "all",
    "height": 30,
    "style": { "mode": "acrylic", "color": "#0B0B0B", "opacity": 0.6 },
    "fontSize": 12,
    "autoHide": false,
    "reserveSpace": true,
    "modules": [
      { "id": "brand", "side": "left" },
      { "id": "date", "side": "left" },
      { "id": "clock", "side": "center" },
      { "id": "planner", "side": "right" },
      { "id": "media", "side": "right" },
      { "id": "weather", "side": "right" },
      { "id": "stats", "side": "right" }
    ]
  },
  "dock": {
    "enabled": true,
    "monitors": "all",
    "size": 55,
    "magnify": true,
    "magnifyMax": 1.6,
    "autoHide": false,
    "reserveSpace": false,
    "showTrash": true,
    "showRunning": true,
    "style": { "mode": "acrylic", "color": "#0B0B0B", "opacity": 0.6 }
  }
}
